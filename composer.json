{
    "name": "porta/graph-viewer",
    "description": "Renders Graphviz, PlantUML and Mermaid diagrams in editor and Markdown previews",
    "type": "porta-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "janalis/viz": "^0.1",
        "symfony/clock": "^8.2",
        "symfony/filesystem": "^8.2",
        "symfony/finder": "^8.2",
        "symfony/process": "^8.2",
        "symfony/tui": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Porta\\GraphViewer\\": "src/"
        }
    },
    "extra": {
        "porta": {
            "requires": [
                "image-viewer"
            ],
            "tools": [
                {
                    "name": "dot",
                    "role": "suggested",
                    "purpose": "renders Graphviz diagrams",
                    "setting": "dotPath",
                    "sources": [
                        [
                            "brew",
                            "graphviz"
                        ]
                    ],
                    "version": [
                        "-V"
                    ]
                },
                {
                    "name": "mmdc",
                    "role": "suggested",
                    "purpose": "renders Mermaid diagrams as images",
                    "setting": "mermaidPath",
                    "sources": [
                        [
                            "npm",
                            "@mermaid-js/mermaid-cli"
                        ],
                        [
                            "brew",
                            "mermaid-cli"
                        ]
                    ]
                },
                {
                    "name": "plantuml",
                    "role": "suggested",
                    "purpose": "renders PlantUML diagrams",
                    "sources": [
                        [
                            "brew",
                            "plantuml"
                        ]
                    ],
                    "version": [
                        "-version"
                    ]
                }
            ]
        }
    }
}
