{
    "name": "porta/graph-viewer",
    "description": "Renders .dot/.gv graphs and PlantUML diagrams in an editor pane",
    "type": "porta-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "symfony/filesystem": "^8.2",
        "symfony/finder": "^8.2",
        "symfony/process": "^8.2",
        "symfony/tui": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Porta\\GraphViewer\\": "src/"
        }
    },
    "extra": {
        "porta": {
            "requires": [
                "image-viewer"
            ]
        }
    }
}
