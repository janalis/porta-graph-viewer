{
    "name": "porta/graph-viewer",
    "description": "Renders Graphviz, PlantUML and Mermaid diagrams in editor and Markdown previews",
    "type": "porta-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "janalis/viz": "^0.1",
        "symfony/clock": "^8.2",
        "symfony/filesystem": "^8.2",
        "symfony/finder": "^8.2",
        "symfony/process": "^8.2",
        "symfony/tui": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Porta\\GraphViewer\\": "src/"
        }
    },
    "extra": {
        "porta": {
            "requires": [
                "image-viewer"
            ]
        }
    }
}
